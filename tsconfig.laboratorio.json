{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@relay/*": ["src/relay/*"],
      "@bot/*": ["src/bot/*"]
    }
  },
  "include": ["laboratorio/find-casino-message.ts", "laboratorio/execute-casino-delete.ts"],
  "exclude": ["node_modules"]
}
