{
  "name": "bot-wpp",
  "version": "1.0.0",
  "description": "",
  "main": "dist/core/multiPlatform.js",
  "scripts": {
    "dev:relay": "tsx watch src/relay/server.ts",
    "dev:screen": "cd src/services/discord-screen/client && npm run dev",
    "build": "npm run build:relay && npm run build:services && npm run build:screen-server && npm run build:platforms && npm run build:core && npm run build:screen",
    "build:relay": "tsup src/relay/server.ts --out-dir dist/relay --format cjs",
    "build:services": "tsup src/services/*.ts src/services/discord-screen/DiscordScreenService.ts --out-dir dist/services --format cjs",
    "build:bot": "tsup src/bot/index.ts src/bot/config.ts src/bot/customCommands.ts src/bot/relayClient.ts src/bot/commands/*.ts --out-dir dist/bot --format cjs",
    "build:platforms": "tsup src/platforms/**/*.ts --out-dir dist/platforms --format cjs",
    "build:core": "tsup src/core/multiPlatform.ts --out-dir dist/core --format cjs",
    "build:screen": "cd src/services/discord-screen/client && npm install && npm run build",
    "build:screen-server": "node -e \"require('child_process');const cp=require('child_process');const s='src/services/discord-screen',d='dist/services/discord-screen';require('fs').mkdirSync(d,{recursive:true});cp.execSync('cp '+s+'/*.js '+d+'/')\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package 2>/dev/null || true",
    "start": "node dist/relay/server.js",
    "bot:start": "node dist/core/multiPlatform.js",
    "test": "vitest run",
    "test-commands": "node test_commands.js",
    "test:watch": "vitest",
    "smoke-test": "node smoke-test.js"
  },
  "engines": {
    "node": ">=20.x"
  },
  "keywords": [],
  "author": "WarriorBlack",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.15.2",
    "cors": "^2.8.6",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "lowdb": "^7.0.1",
    "nodemon": "^3.1.14",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "telegraf": "^4.16.3",
    "typescript": "^6.0.3",
    "winston": "^3.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/qrcode-terminal": "^0.12.2",
    "jest": "^30.4.2",
    "patch-package": "^8.0.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
