{
  "name": "bot-wpp",
  "version": "1.0.0",
  "description": "",
  "main": "dist/core/multiPlatform.js",
  "scripts": {
      "dev:relay": "tsx watch src/relay/server.ts",
      "dev:screen": "npm --prefix discord-screen/client run dev",
      "dev:screen-server": "npm --prefix discord-screen/server run dev",
      "build": "npm run build:relay && npm run build:services && npm run build:platforms && npm run build:core && npm run build:screen",
      "build:relay": "tsup src/relay/server.ts --out-dir dist/relay --format cjs",
      "build:services": "tsup src/services/*.ts src/services/discord-screen/DiscordScreenService.ts --out-dir dist/services --format cjs",
      "build:platforms": "tsup src/platforms/**/*.ts --out-dir dist/platforms --format cjs",
      "build:core": "tsup src/core/multiPlatform.ts --out-dir dist/core --format cjs",
      "build:screen": "npm --prefix discord-screen run build",
      "screen:install": "npm --prefix discord-screen install",
      "screen:build": "npm --prefix discord-screen run build",
      "screen:dev": "cd discord-screen/server && npm run dev",
      "screen:start": "cd discord-screen/server && npm start",
      "screen:tunel": "cd discord-screen && npm run tunel",
      "screen:tunel:criar": "cd discord-screen && npm run tunel:criar",
      "screen:configurar": "cd discord-screen && npm run configurar",
      "typecheck": "tsc --noEmit",
      "start": "node dist/relay/server.js",
      "bot:start": "node dist/core/multiPlatform.js",
      "test": "vitest run",
      "test:watch": "vitest"
    },
  "engines": {
    "node": ">=20.x"
  },
  "keywords": [],
  "author": "WarriorBlack",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.15.2",
    "cors": "^2.8.6",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "lowdb": "^7.0.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "telegraf": "^4.16.3",
    "typescript": "^6.0.3",
    "winston": "^3.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
